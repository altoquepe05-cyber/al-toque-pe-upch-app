PORT=4173
HOST=0.0.0.0
DATA_BACKEND=file
DATA_DIR=data
APP_SERVER_URL=
TLS_CERT_FILE=
TLS_KEY_FILE=

# Set DATA_BACKEND=supabase and add these server-only credentials for hosted persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# TURN is optional; TURN_URL accepts comma-separated ICE server URLs.
TURN_URL=
TURN_USER=
TURN_PASS=

# YouTube Data API v3 key used by the in-app video search.
YOUTUBE_API_KEY=

# Gmail OAuth sends opt-in confirmation emails from this Gmail account.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Set MARKETING_PROVIDER=hubspot to register website opt-ins in HubSpot.
MARKETING_PROVIDER=gmail
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_LIST_ID=9
HUBSPOT_SUBSCRIPTION_ID=

# The assistant uses OpenAI; rider support falls back to the local Keras service if OpenAI is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
KERAS_API_URL=http://127.0.0.1:5000/preguntar

# Configure a strong private value to enable deleting Reels.
REELS_DELETE_PASSWORD=
